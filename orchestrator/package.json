{
  "name": "kunpeng-orchestrator",
  "license": "UNLICENSED",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kunpeng": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/with-build-lock.mjs npx --no-install tsc -p tsconfig.json",
    "build:nolock": "tsc -p tsconfig.json",
    "prepare": "npm run build:nolock",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src test",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "5.4.624",
    "simple-git": "^3.27.0",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.10.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "nanoid": "^3.3.18",
    "js-yaml": "^3.15.2",
    "brace-expansion": "^5.0.9"
  }
}
