# 先复制为 .env，并把两个路径改成宿主机上的真实绝对路径。
# docker-compose 会把 KUNPENG_STATE 挂载到容器内 /var/lib/kunpeng，
# 把 KUNPENG_REPO 挂载到容器内 /workspace/repo。
KUNPENG_STATE=/home/kunpeng/.kunpeng
KUNPENG_REPO=/srv/my-project

# 可选：决定容器进程的 uid/gid；该身份必须能写入挂载的目标仓与状态目录。
# KUNPENG_UID=1000
# KUNPENG_GID=1000

# agent 后端：codex 或 claude；留空时按阶段使用内置路由。
KUNPENG_BACKEND=codex

# 可选：Claude Code 长期令牌（在有浏览器的机器上运行 claude setup-token 取得），
# 用于不在容器里交互登录 Claude Code。切勿提交真实令牌。
# CLAUDE_CODE_OAUTH_TOKEN=

# 原生部署默认只监听本机。Compose 会在容器内覆盖为 0.0.0.0，
# 同时只把 7777 发布到宿主机 127.0.0.1。
KUNPENG_HOST=127.0.0.1
KUNPENG_ALLOW_INSECURE=1

# 执行位置：local 或 codex-cloud。
KUNPENG_EXECUTION_BACKEND=local

# 日志可设为 json 或 debug；不设时仅输出 warn/error。
# KUNPENG_LOG=json

# 单次 run 的可选预算；不设表示该维度不限。
# KUNPENG_RUN_TOKEN_BUDGET=120000
# KUNPENG_RUN_USD_BUDGET=20

# 单 flow 的可选预算（token、毫秒、美元）。
# KUNPENG_FLOW_TOKEN_BUDGET=60000
# KUNPENG_FLOW_MS_BUDGET=3600000
# KUNPENG_FLOW_USD_BUDGET=10

# 只在临时执行 `kunpeng auth set-password` 时注入，切勿提交真实密码。
# KUNPENG_AUTH_PASSWORD=replace-with-a-temporary-secret
